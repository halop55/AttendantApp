NODE_ENV=development
PORT=3031

# Supabase project used by src/lib/supabase.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Logto JWT verification support kept by src/shared/middleware/jwt.middleware.ts.
LOGTO_ENDPOINT=https://your-logto-tenant.logto.app
LOGTO_AUDIENCE=https://attendance-api
LOGTO_SCOPE=attendance:read attendance:write

# Firebase Auth ID token verification support.
# Current frontend config uses projectId chat-messenger-71c1e.
FIREBASE_PROJECT_ID=chat-messenger-71c1e

# Local development only. When true and no Authorization header is sent,
# backend uses a fixed dev user: test@company.com.
BYPASS_AUTH=false

# Keep enabled in normal development/production. Only set 0 for local TLS debugging.
NODE_TLS_REJECT_UNAUTHORIZED=1
